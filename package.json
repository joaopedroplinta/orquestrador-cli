{
  "name": "orquestrador-cli",
  "version": "0.1.0",
  "description": "CLI que orquestra Claude Code e Antigravity trabalhando juntos numa mesma tarefa",
  "type": "module",
  "bin": {
    "orquestrador": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/cli.js",
    "prepublishOnly": "npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "claude-code",
    "antigravity",
    "ai-agent",
    "orchestration",
    "automation"
  ],
  "author": {
    "name": "João Pedro dos Santos Henrique Plinta",
    "email": "joaopedrohenriqueplinta@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaopedroplinta/orquestrador-cli.git"
  },
  "bugs": {
    "url": "https://github.com/joaopedroplinta/orquestrador-cli/issues"
  },
  "homepage": "https://github.com/joaopedroplinta/orquestrador-cli#readme",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.3.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ora": "^8.1.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.0"
  }
}
